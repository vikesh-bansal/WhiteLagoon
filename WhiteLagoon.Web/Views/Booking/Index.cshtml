@using WhiteLagoon.Application.Common.Utility
@{
    var status = Context.Request.Query["status"];
    var approved = "";
    var pending = "";
    var checkedId = "";
    var completed = "";
    var cancelled = "";

    switch (status)
    {
        case SD.StatusPending:
            pending = "text-white bg-success";
            break;
        case SD.StatusApproved:
            approved = "text-white bg-success";
            break;
        case SD.StatusCheckedIn:
            checkedId = "text-white bg-success";
            break;
        case SD.StatusCompleted:
            completed = "text-white bg-success";
            break;
        case SD.StatusCancelled:
            cancelled = "text-white bg-success";
            break;
        default:
            break;
    }
}
<div class="w-100 card border-0 p-4">
    <div class="card-header bg-success bg-gradient m1-100 py-3">
        <div class="row">

            <div class="col-12 text-center">
                <h2 class="text-white py-2">Booking List</h2>
            </div>
        </div>
    </div>
    <div class="card-body border p-4">
        <div class="d-flex justify-content-end pb-4 pt-2">
            <ul class="list-group list-group-horizontal-sm">
                <a style="text-decoration:none;" asp-controller="Booking" asp-action="Index" asp-route-status="@SD.StatusPending">
                    <li class="list-group-item">@SD.StatusPending</li>
                    <li class="list-group-item @pending">@SD.StatusPending</li>
                </a>
                <a style="text-decoration:none" asp-action="Index" asp-controller="Booking" asp-route-status="@SD.StatusApproved">
                    <li class="list-group-item">@SD.StatusApproved</li>
                    <li class="list-group-item @approved">@SD.StatusApproved</li>
                </a>
                <a style="text-decoration:none" asp-action="Index" asp-controller="Booking" asp-route-status="@SD.StatusCheckedIn">
                <li class="list-group-item">@SD.StatusCheckedIn</li>
                <li class="list-group-item @checkedId">@SD.StatusCheckedIn</li>
                </a>
                <a style="text-decoration:none" asp-action="Index" asp-controller="Booking" asp-route-status="@SD.StatusCompleted">
                <li class="list-group-item">@SD.StatusCompleted</li>
                <li class="list-group-item @completed">@SD.StatusCompleted</li>
                </a>
                <a style="text-decoration:none" asp-action="Index" asp-controller="Booking" asp-route-status="@SD.StatusCancelled">
                <li class="list-group-item">@SD.StatusCancelled</li>
                <li class="list-group-item @cancelled">@SD.StatusCancelled</li>
                </a>
            </ul>
        </div>
        <table class="table table-bordered table-striped" id="tblBookings">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Phone</th>
                    <th>Email</th>
                    <th>Status</th>
                    <th>Check In Date</th>
                    <th>Nights</th>
                    <th>Total</th>
                    <th></th>
                </tr>
            </thead>
        </table>
    </div>
</div>

@section Scripts{
    <script src="~/js/booking.js" asp-append-version="true"></script>
}