@model Booking
<div class="p-4 mt-0 mt-lg-4">
    <div class="row" style="border: 1px solid #aaa;">
        <div class="col-12 col-lg-6 p-4 2 mt-2 mt-md-0">
            <div class="row p-1" style="border-radius:20px;">
                <div class="col-6">
                    <h3 class="text-success">Villa Details</h3>
                </div>
                <div class="col-6 text-end">
                    <a class="btn btn-secondary my-2" asp-controller="Booking" asp-action="" asp-route-status="@Model.Status"><i class="bg bi-arrow-left-circle"></i> Back to Bookings</a>
                </div>
                <hr />
              <partial name="_VillaDetail" model="@Model.Villa" />
                <hr />
                <div class="text-end">
                    <h4 class="text-danger font-weight-bold">
                        Booking Total :
                        <span style="border-bottom:1px solid #ff6a00">
                            @Model.Totalcost.ToString("c")
                        </span>
                    </h4>
                </div>
                <hr />
                <form method="post">
                    <div class="row pt-1 mb-3" style="border-radius: 20px;">
                        <div class="col-12 text-center">
                            <button asp-action="GenerateInvoice" asp-route-id="@Model.Id" type="submit" class="btn btn-sm btn-secondary my-1" asp-route-downloadType="word">
                                <i class="bi bi-sm btn-secondary my-1"></i> Generate Invoice (word)
                            </button>
                            <button asp-action="GenerateInvoice" asp-route-id="@Model.Id" type="submit" class="btn btn-sm btn-secondary my-1" asp-route-downloadType="pdf">
                                <i class="bi bi-sm btn-secondary my-1"></i> Generate Invoice (pdf)"
                                </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
        <div class="col-12 col-lg-6 p-4 2 mt-4 mt-md-0" style="border-left: 1px solid #aaa">
            <form method="post">
                <input asp-for="Id" hidden />
                <input asp-for="VillaId" hidden />
                <input asp-for="UserId" hidden />
                <input asp-for="CheckInDate" hidden />
                <input asp-for="CheckOutDate" hidden />
                <input asp-for="Nights" hidden />

                <div class="row pt-1 mb-3" style="border-radius: 20px;">
                    <div class="col-6">
                        <h3 class="text-success">Enter Booking Details</h3>
                    </div>
                    <div class="col-6">
                        @if ((Model.Status == SD.StatusApproved || Model.Status == SD.StatusPending) && User.IsInRole(SD.Role_Admin))
                        {
                            <button type="submit" class="btn btn-sm btn-outline-danger form-control my-1" asp-controller="Booking" asp-action="CancelBooking"><i class="bi bi-x-circle"></i>&nbsp; Cancel Booking</button>
                        }
                    </div>
                </div>
                <div class="row">
                    <div class="form-group pt-2 col-6">
                        <label class="text-warning">Name</label>
                        <input class="form-control" asp-for="Name" />
                    </div>
                    <div class="form-group pt-2 col-6">
                        <label class="text-warning">Phone</label>
                        <input class="form-control" asp-for="Phone" />
                    </div>
                    <div class="form-group pt-2 col-6">
                        <label class="text-warning">Email</label>
                        <input class="form-control" asp-for="Email" />
                    </div>
                   
                    <div class="form-group pt-2 col-6">
                        <label class="text-warning">No. of nights</label>
                        <input class="form-control" asp-for="Nights" disabled />
                    </div>
                    <div class="form-group pt-2 col-6">
                        <label class="text-warning">Status</label>
                        <input class="form-control" asp-for="Status" disabled />
                    </div>
                    <div class="form-group pt-2 col-6">
                        <label class="text-warning">Booking Date</label>
                        <input class="form-control" asp-for="BookingDate" disabled />
                    </div>
                    <div class="form-group pt-2 col-6">
                        <label class="text-warning">Check-in Date</label>
                        <input class="form-control" asp-for="CheckInDate" disabled />
                    </div>
                    <div class="form-group pt-2 col-6">
                        <label class="text-warning">Actual Check-in Date</label>
                        <input class="form-control" asp-for="ActualCheckInDate" disabled  />
                    </div>
                    <div class="form-group pt-2 col-6">
                        <label class="text-warning">Check-out Date</label>
                        <input class="form-control" asp-for="CheckOutDate" disabled />
                    </div>
                    <div class="form-group pt-2 col-6">
                        <label class="text-warning">Actual Check-out Date</label>
                        <input class="form-control" asp-for="ActualCheckOutDate" disabled />
                    </div>
                    @if(Model.Status==SD.StatusApproved && User.IsInRole(SD.Role_Admin))
                    {
                        <div class="form-group pt-2 col-6">
                            <label class="text-danger" asp-for="VillaNumber"></label>
                            <select class="form-select" asp-for="VillaNumber">
                                @foreach(var item in Model.VillaNumbers)
                                {
                                    <option value="@item.Villa_Number">@item.Villa_Number</option>
                                }
                            </select>
                        </div>
                    }
                    else
                    {
                        <input asp-for="VillaNumber" hidden />
                        @if(Model.Status == SD.StatusCheckedIn || Model.Status == SD.StatusCompleted)
                        {
                            <div class="form-group pt-2 col-6">
                                <label class="text-warning">Villa Number</label>
                                <input asp-for="VillaNumber" disabled class="form-control" />
                            </div>
                        }
                    }
                    @if(Model.IsPaymentSuccessful && User.IsInRole(SD.Role_Admin))
                    {
                        <div class="form-group pt-2 col-6">
                            <label class="text-warning">Stripe PaymentIntent Id</label>
                            <input class="form-control" asp-for="StripePaymentIntentId" disabled />
                        </div>
                        <div class="form-group pt-2 col-6">
                            <label class="text-warning">Stripe Session Id</label>
                            <input class="form-control" asp-for="StripeSessionId" disabled />
                        </div>
                        <div class="form-group pt-2 col-6">
                            <label class="text-warning">Payment Date</label>
                            <input class="form-control" asp-for="PaymentDate" disabled />
                        </div>
                    }
                    <div class="form-group pt-2 col-6">
                        <label class="text-warning">Status</label>
                        <input asp-for="Status" disabled class="form-control" />
                    </div>
                </div>
                <div class="form-group pt-2 pt-md-4">
                    @if (User.IsInRole(SD.Role_Admin))
                    {
                        if (Model.Status == SD.StatusApproved)
                        {
                            <button type="submit" class="btn btn-warning form-control my-1" asp-controller="Booking" asp-action="CheckIn"><i class="bi bi-check2-square"></i>&nbsp; Check In</button>
                        }
                        if (Model.Status == SD.StatusCheckedIn)
                        {
                            <button type="submit" class="btn btn-success form-control my-1" asp-controller="Booking" asp-action="CheckOut"><i class="bi bi-clipboard2-check"></i>&nbsp; Check Out / Complete Booking</button>
                        }
                    }
                    
                </div>
            </form>
        </div>
    </div>
</div>